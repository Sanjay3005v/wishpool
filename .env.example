# Upstash Redis Configuration (from Vercel Marketplace -> Upstash Redis or upstash.com)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional: Public site URL for production Open Graph images and share links
NEXT_PUBLIC_APP_URL=https://wishpool.vercel.app
